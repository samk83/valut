{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "default"
      }
    },
    "beta": {
      "extends": "production",
      "channel": "beta",
      "env": {
        "APP_VARIANT": "beta"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6832844680"
      }
    },
    "beta": {
      "ios": {
        "ascAppId": "6832844680"
      }
    }
  }
}
